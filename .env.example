# Copy to .env. Secrets stay on the FastAPI server. Never use VITE_ for secrets.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APP_URL=http://127.0.0.1:8765

STOREFRONT_URL=http://127.0.0.1:8000
# Only these exact public hosts can be visited. No arbitrary internal URLs.
AUDIT_ALLOWED_HOSTS=
# Demo quote, not a partner offer; price is USD/tonne. Partner leg stays simulated.
OFFSET_PRICE_PER_TONNE=100
OFFSET_PARTNER=Demo carbon partner (uncontracted)
